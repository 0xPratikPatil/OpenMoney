{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "composite": true
  },
  "exclude": ["node_modules", "dist", ".next", "reference", "auth.ts", "bun-test-setup.ts", "packages/openmoney-ui", "packages/providers/cftc", "packages/providers/congress_gov", "packages/providers/famafrench", "packages/providers/federal_reserve", "packages/providers/multpl", "packages/providers/stockgrid", "apps/web", "apps/notification", "apps/docs", "**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
