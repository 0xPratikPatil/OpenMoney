{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/lib/*": [
        "../../packages/openmoney-ui/src/lib/*"
      ],
      "@/hooks/*": [
        "../../packages/openmoney-ui/src/hooks/*"
      ],
      "@/tokens/*": [
        "../../packages/openmoney-ui/src/tokens/*"
      ],
      "@/components/ui/*": [
        "../../packages/openmoney-ui/src/components/ui/*"
      ],
      "@/components/openmoney/*": [
        "../../packages/openmoney-ui/src/components/openmoney/*"
      ]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
