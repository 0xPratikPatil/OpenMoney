# ─── Database ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openmoney
REDIS_URL=redis://localhost:6379

# ─── API Gateway ───
PORT=4000
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:4000

# ─── OAuth (optional — only needed if using social login) ───
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_ID=
# GOOGLE_SECRET=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── Data Ingestion ───
YFINANCE_ENABLED=true
YFINANCE_RATE_LIMIT_MS=2000
# POLYGON_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# ─── Quant Engine ───
QUANT_PYTHON_URL=http://localhost:5000

# ─── Notification (optional) ───
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# ─── Monitoring (optional) ───
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── App ───
NODE_ENV=development
