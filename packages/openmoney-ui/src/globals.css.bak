@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: #F8F8FA;
    --foreground: #1C1B1A;
    --primary: #1C1B1A;
    --primary-fg: #F8F8FA;
    --secondary: #E8E8EE;
    --secondary-fg: #1C1B1A;
    --muted: #E8E8EE;
    --muted-fg: #6B6A72;
    --accent: #E8E8EE;
    --accent-fg: #1C1B1A;
    --border: #D6D6DE;
    --input: #D6D6DE;
    --ring: #8E8D96;
    --destructive: #DC2626;
    --positive: #16A34A;
    --negative: #DC2626;
    --warning: #D97706;
    --info: #2563EB;
    --accent-brand: #059669;
    --accent-brand-hover: #047857;
    --radius: 0.375rem;
    --font-sans: ''Inter'', -apple-system, BlinkMacSystemFont, ''Segoe UI'', sans-serif;
    --font-mono: ''JetBrains Mono'', ''Fira Code'', ''SF Mono'', ''Consolas'', monospace;
  }

  .dark {
    --background: #0C0C0F;
    --foreground: #F0EFED;
    --primary: #F0EFED;
    --primary-fg: #0C0C0F;
    --secondary: #1E1E26;
    --secondary-fg: #F0EFED;
    --muted: #1E1E26;
    --muted-fg: #8E8D96;
    --accent: #1E1E26;
    --accent-fg: #F0EFED;
    --border: #26262E;
    --input: #26262E;
    --ring: #6B6A78;
    --destructive: #7F1D1D;
    --accent-brand: #059669;
    --accent-brand-hover: #047857;
  }

  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* All numbers in data contexts use mono */
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
}

@layer components {
  /* Background patterns */
  .bg-grid-fine {
    background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .dark .bg-grid-fine {
    background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px);
  }
  .bg-grid-finance {
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 23px,
      rgba(255,255,255,0.04) 23px,
      rgba(255,255,255,0.04) 24px
    );
  }

  /* Data containers - flat, no shadow */
  .data-card {
    @apply bg-secondary border border-border rounded-lg;
  }

  .metric-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Callout left-border variants */
  .callout-info { border-left-color: #3B82F6; }
  .callout-warn { border-left-color: #F59E0B; }
  .callout-error { border-left-color: #EF4444; }
  .callout-success { border-left-color: #10B981; }
}
